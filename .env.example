# Identifiants de l'application créée sur https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chaîne sur laquelle Claude agit (login Twitch, en minuscules)
TWITCH_CHANNEL=
# Optionnel : emplacement du fichier de jetons (défaut : ~/.twitch-mcp/tokens.json)
# TWITCH_TOKEN_FILE=
# Optionnel : port local utilisé par `npm run auth` (défaut : 3000)
# TWITCH_AUTH_PORT=3000
